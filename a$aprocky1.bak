		<td colspan="2" class="td-left480">
		      <!-- #BeginEditable "X" --><A href="best2013.htm">2013 Black Music Best50 10位</A><BR>
      2014 The 56th Grammy Nominees : Best Rap Song<br>
      <iframe height="450" width="100%" title="Media player" src="https://embed.music.apple.com/us/album/long-live-a%24ap-deluxe-edition/1450690198?itscg=30200&amp;itsct=music_box_player&amp;ls=1&amp;app=music&amp;mttnsubad=1450690198&amp;at=11lcug&amp;theme=light" id="embedPlayer" sandbox="allow-forms allow-popups allow-same-origin allow-scripts allow-top-navigation-by-user-activation" allow="autoplay *; encrypted-media *; clipboard-write" style="border: 0px; border-radius: 12px; width: 100%; height: 450px; max-width: 480px;"></iframe><!-- #EndEditable --> 
			<TABLE class="t2">
				<COL span="3">
				<TBODY> 
					<TR> 
						<TD colspan="3" class="header1">Score Card</TD>
					</TR>
					<TR class="size1"> 
						<TD class="td-left">ラップ(rap oriented)</TD>
						<TD class="td-center170"><!-- #BeginEditable "C" --><img src="1.gif" width="170" height="30" border="0"><!-- #EndEditable --></TD>
						<TD class="td-right">歌(song oriented)</TD>
					</TR>
					<TR class="size1"> 
						<TD class="td-gray-left">アーバン(urban)</TD>
						<TD class="td-center170-gray"><!-- #BeginEditable "D" --><img src="1.gif" width="170" height="30" border="0"><!-- #EndEditable --></TD>
						<TD class="td-gray-right">アーシー(earthy)</TD>
					</TR>
					<TR class="size1"> 
						<TD class="td-left">聴きやすい(familiar)</TD>
						<TD class="td-center170"><!-- #BeginEditable "E" --><img src="2.gif" width="170" height="30" border="0"><!-- #EndEditable --></TD>
						<TD class="td-right">リスナーを選ぶ(serious)</TD>
					</TR>
					<TR class="size1"> 
						<TD class="td-gray-left">評点(rating)</TD>
						<TD class="td-center170-gray"><!-- #BeginEditable "F" --><img src="biz3_b3.gif" width="30" height="30" border="0"><img src="biz3_b3.gif" width="30" height="30" border="0"><img src="biz3_b3.gif" width="30" height="30" border="0"><img src="biz3_b3.gif" width="30" height="30" border="0"> <img src="biz3_b3h.GIF" width="20" height="20" border="0"><!-- #EndEditable --></TD>
						<TD class="td-gray-right">（5点満点 fullmark :5）</TD>
					</TR>
					<tr class="size1">
						<td colspan="3">      <!-- #BeginEditable "Y" -->延期を重ねた結果、やっと2013年になってリリースされたA$ap Rockyのデビューアルバム。Mixtape / net世代の最近の新人MCの中でも特に注目度が高かったわけだが、期待を裏切らない内容になっている。NY出身ながら、ベースはサウスっぽくて、Screwedを多用しつつも、時代の流れのアンビエントな音やシンセを積極的に取り入れているところが、新鮮だ。Guestもベテランは無しで、若手の旬な人たちを起用しており。次世代を感じさせる作品である。Rapの腕や表現力も問題ない。<!-- #EndEditable --> </TD>
					</TR>
				</TBODY> 	
			</TABLE>
